# Copy to backend/.env (gitignored) and fill in. Never commit the real file.
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Frontend origin allowed by CORS and used in QR codes (comma-separate several)
FRONTEND_URL=http://localhost:3000

# Optional - the app works without it (non-AI fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to true ONCE to reload data tables from the CSVs, then back to false
RESEED_ON_START=false
