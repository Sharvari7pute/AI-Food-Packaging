# Copy to backend/.env (gitignored) and fill in. Never commit the real file.
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Frontend origin allowed by CORS and used in QR codes (comma-separate several)
FRONTEND_URL=http://localhost:3000

# Optional - the app works without it (non-AI fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Tried in order when the main model hits its (per-model) free-tier quota
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# Optional backup AI (Groq, OpenAI-compatible) - used only if every Gemini model fails or hits quota
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Set to true ONCE to reload data tables from the CSVs, then back to false
RESEED_ON_START=false

# Optional keep-alive (free hosting sleeps after ~15 min idle). Uses free hours - enable for demo days only.
KEEPALIVE_ENABLED=false
KEEPALIVE_START_HOUR_IST=8
KEEPALIVE_END_HOUR_IST=22
